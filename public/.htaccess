# ======================================================================
# Browser Caching & Performance Optimization
# ======================================================================

# 1. Expires Headers (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Dynamic Data (no cache so new deployments appear immediately)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # CSS & JavaScript (1 Year - Vite hashes production assets)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images & Media (1 Year)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType audio/ogg "access plus 1 year"

  # Web Fonts (1 Year)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# 2. Cache-Control HTTP Headers (mod_headers)
<IfModule mod_headers.c>
  # 1 Year cache for static assets (images, fonts, media)
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff|woff2|ttf|otf|eot|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 1 Year cache for CSS and JavaScript bundles
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Prevent HTML caching to ensure immediate updates after deployment
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# 3. Gzip / Deflate Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ======================================================================
# URL Rewrites & Single Page Application Routing (mod_rewrite)
# ======================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirects
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^services/mobile-app-development/?$ /mobile-app-development [R=301,L]
  RewriteRule ^services/web-design-development/?$ /web-development [R=301,L]
  RewriteRule ^services/digital-marketing/?$ /digital-marketing [R=301,L]
  RewriteRule ^services-digital-marketing/?$ /digital-marketing [R=301,L]
  RewriteRule ^services/ecommerce-development/?$ /ecommerce [R=301,L]
  RewriteRule ^services/ecommerce/?$ /ecommerce [R=301,L]
  RewriteRule ^services/erp-solutions/?$ /erp-solution [R=301,L]
  RewriteRule ^services-erp-solution/?$ /erp-solution [R=301,L]
  RewriteRule ^services/search-engine-optimization/?$ /seo [R=301,L]
  RewriteRule ^prodcuts/erp/?$ /erp-product [R=301,L]
  RewriteRule ^products/erp/?$ /erp-product [R=301,L]
  RewriteRule ^products/hrms/?$ /hrms [R=301,L]
  RewriteRule ^products/accounting-software/?$ /accounting-software [R=301,L]
  RewriteRule ^products/whatsapp-chatbot/?$ /whatsapp-chatbot [R=301,L]
  RewriteRule ^products/project-management/?$ /project-management [R=301,L]
  RewriteRule ^products/task-management/?$ /task-management [R=301,L]
  RewriteRule ^products/pro-solutions/?$ /pro-solutions [R=301,L]

  # SPA Routing: Send all non-file/directory requests to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
